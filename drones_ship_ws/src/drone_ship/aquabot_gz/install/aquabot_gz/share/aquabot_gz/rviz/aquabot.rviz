Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF

    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: RobotModel
      Robot Description: aquabot_description
      TF Prefix: aquabot

    - Class: rviz_default_plugins/Imu
      Enabled: true
      Name: IMU
      Topic: /sensors/imu/imu/data
      Alpha: 1.0
      Scale: 1.0
      Color: 255; 0; 0

    - Class: rviz_default_plugins/Map
      Enabled: false
      Name: Map

    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Markers

    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: PointCloud

    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Camera
      Topic: /sensors/cameras/main_camera_sensor/image_raw
      Transport Hint: raw

    - Class: rviz_default_plugins/GPS
      Enabled: true
      Name: GPS
      Topic: /sensors/gps/gps/fix
      Color: 0; 255; 0
      History Length: 10

  Enabled: true
  Global Options:
    Fixed Frame: map
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true

