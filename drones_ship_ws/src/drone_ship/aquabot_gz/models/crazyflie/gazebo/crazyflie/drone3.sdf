<sdf version="1.8">
  <model name="drone3">
    <link name="drone3/body">
      <pose> 0 0 17.425E-3 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>  <!-- assumes CoM at link center -->
        <mass>0.025</mass>
        <inertia>
          <ixx>16.571710E-05</ixx>  <!-- changed from -06  by farhan 23/06/2025-->
          <iyy>16.655602E-05</iyy>
          <izz>29.261652E-05</izz>
          <ixy>0.830806E-05</ixy>
          <ixz>0.718277E-05</ixz>
          <iyz>1.800197E-05</iyz>
        </inertia>
      </inertial>
      <collision name="drone3/body_collision">
        <geometry>
          <box>
            <size>0.10 0.10 34.850E-3</size>
          </box>
        </geometry>
      </collision>
      <visual name="drone3/body_visual">
        <geometry>
          <mesh>
            <uri>../../../meshes/collada_files/cf2_assembly.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <sensor name='multiranger' type='gpu_lidar'>"
        <pose relative_to='drone3/base_link'>0 0 0.1 0 0 0</pose>
        <topic>lidar</topic>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
                <samples>4</samples>
                <resolution>1</resolution>
                <min_angle>-3.14</min_angle>
                <max_angle>1.57</max_angle>
            </horizontal>
            <vertical>
                <samples>1</samples>
                <resolution>0.01</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.01</min>
            <max>3.49</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>

   <!-- GPS Sensor -->
     <sensor name="navsat" type="navsat">
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <gps/>
    </sensor>

    <!-- IMU Sensor -->
    <sensor name="imu_sensor" type="imu">
      <pose>0 0 0.01 0 0 0</pose>
      <update_rate>100</update_rate>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0005</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0005</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0005</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.2</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.2</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.2</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>

    </sensor>
    </link>

        <!-- Downward Left Camera Link -->
    <link name="drone3/downward_left_camera_link">
      <pose>-0.05 0 -0.02 0 1.5708 0</pose>  <!-- 10cm baseline -->
      <inertial><mass>0.0001</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia></inertial>
      <sensor name="left_camera_sensor" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.39626</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.01</near><far>100.0</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>/drone3/downward_left_camera/image_raw</topic>
      </sensor>
    </link>



        <!-- Downward Right Camera Link -->
    <link name="drone3/downward_right_camera_link">
      <pose>0.05 0 -0.02 0 1.5708 0</pose> <!-- 10cm baseline -->
      <inertial><mass>0.0001</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia></inertial>
      <sensor name="right_camera_sensor" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.39626</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.01</near><far>100.0</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>/drone3/downward_right_camera/image_raw</topic>
      </sensor>
    </link>


    <!-- Fixed Joints for Cameras -->
    <joint name="drone3/downward_left_camera_joint" type="fixed">
      <parent>drone3/body</parent>
      <child>drone3/downward_left_camera_link</child>
    </joint>
    <joint name="drone3/downward_right_camera_joint" type="fixed">
      <parent>drone3/body</parent>
      <child>drone3/downward_right_camera_link</child>
    </joint>



    <link name="drone3/m1_prop">
      <pose>0.031 -0.031 0.021 0 0 0</pose>
      <inertial>
        <mass>0.0008</mass>
        <inertia>
          <ixx>8.33333E-09</ixx>
          <iyy>1.08333E-07</iyy>
          <izz>1.13333E-07</izz>
        </inertia>
      </inertial>
      <visual name="drone3/m1_visual">
        <geometry>
          <mesh>
            <uri>../../../meshes/collada_files/ccw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <link name="drone3/m2_prop">
      <pose>-0.031 -0.031 0.021 0 0 0</pose>
      <inertial>
        <mass>0.0008</mass>
        <inertia>
          <ixx>8.33333E-09</ixx>
          <iyy>1.08333E-07</iyy>
          <izz>1.13333E-07</izz>
        </inertia>
      </inertial>
      <visual name="drone3/m2_visual">
        <geometry>
          <mesh>
            <uri>../../../meshes/collada_files/cw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <link name="drone3/m3_prop">
      <pose>-0.031 0.031 0.021 0 0 0</pose>
      <inertial>
        <mass>0.0008</mass>
        <inertia>
          <ixx>8.33333E-09</ixx>
          <iyy>1.08333E-07</iyy>
          <izz>1.13333E-07</izz>
        </inertia>
      </inertial>
      <visual name="drone3/m3_visual">
        <geometry>
          <mesh>
            <uri>../../../meshes/collada_files/ccw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <link name="drone3/m4_prop">
      <pose>0.031 0.031 0.021 0 0 0</pose>
      <inertial>
        <mass>0.0008</mass>
        <inertia>
          <ixx>8.33333E-09</ixx>
          <iyy>1.08333E-07</iyy>
          <izz>1.13333E-07</izz>
        </inertia>
      </inertial>
      <visual name="drone3/m4_visual">
        <geometry>
          <mesh>
            <uri>../../../meshes/collada_files/cw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name="drone3/m1_joint" type="revolute">
      <child>drone3/m1_prop</child>
      <parent>drone3/body</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>
    <joint name="drone3/m2_joint" type="revolute">
      <child>drone3/m2_prop</child>
      <parent>drone3/body</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>
    <joint name="drone3/m3_joint" type="revolute">
      <child>drone3/m3_prop</child>
      <parent>drone3/body</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>
    <joint name="drone3/m4_joint" type="revolute">
      <child>drone3/m4_prop</child>
      <parent>drone3/body</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>
    <!-- <plugin name="Wind" filename="libignition-gazebo-wind-system.so">
       <windEnabled>true</windEnabled>
    </plugin> -->
    <plugin
      filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>drone3</robotNamespace>
      <jointName>drone3/m1_joint</jointName>
      <linkName>drone3/m1_prop</linkName>
      <turningDirection>ccw</turningDirection>
      <maxRotVelocity>2618</maxRotVelocity>
      <motorConstant>1.28192e-08</motorConstant>
      <momentConstant>0.005964552</momentConstant>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>0.0000001</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
      <actuator_number>0</actuator_number>
      <motorType>velocity</motorType>
    </plugin>
    <plugin
      filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>drone3</robotNamespace>
      <jointName>drone3/m2_joint</jointName>
      <linkName>drone3/m2_prop</linkName>
      <turningDirection>cw</turningDirection>
      <maxRotVelocity>2618</maxRotVelocity>
      <motorConstant>1.28192e-08</motorConstant>
      <momentConstant>0.005964552</momentConstant>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>0.0000001</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
      <actuator_number>1</actuator_number>
      <motorType>velocity</motorType>
    </plugin>
    <plugin
      filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>drone3</robotNamespace>
      <jointName>drone3/m3_joint</jointName>
      <linkName>drone3/m3_prop</linkName>
      <turningDirection>ccw</turningDirection>
      <maxRotVelocity>2618</maxRotVelocity>
      <motorConstant>1.28192e-08</motorConstant>
      <momentConstant>0.005964552</momentConstant>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>0.0000001</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
      <actuator_number>2</actuator_number>
      <motorType>velocity</motorType>
    </plugin>
    <plugin
      filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>drone3</robotNamespace>
      <jointName>drone3/m4_joint</jointName>
      <linkName>drone3/m4_prop</linkName>
      <turningDirection>cw</turningDirection>
      <maxRotVelocity>2618</maxRotVelocity>
      <motorConstant>1.28192e-08</motorConstant>
      <momentConstant>0.005964552</momentConstant>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>0.0000001</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
      <actuator_number>3</actuator_number>
      <motorType>velocity</motorType>
    </plugin>
    <plugin
      filename="gz-sim-multicopter-control-system"
      name="gz::sim::systems::MulticopterVelocityControl">
      <robotNamespace>drone3</robotNamespace>
      <commandSubTopic>gazebo/command/twist</commandSubTopic>
      <enableSubTopic>enable</enableSubTopic>
      <comLinkName>drone3/body</comLinkName>
      <velocityGain>1.25 1.25 0.2425</velocityGain>
      <attitudeGain>0.05 0.05 0.05</attitudeGain>
       <!-- <attitudeGain>0.02 0.02 0.02</attitudeGain> -->
      <angularRateGain>0.01 0.01 0.01</angularRateGain>
      <!-- <angularRateGain>0.005 0.005 0.005</angularRateGain> -->
      <rotorConfiguration>
        <rotor>
          <jointName>drone3/m1_joint</jointName>
          <forceConstant>1.28192e-08</forceConstant>
          <momentConstant>0.005964552</momentConstant>
          <direction>1</direction>
        </rotor>
        <rotor>
          <jointName>drone3/m2_joint</jointName>
          <forceConstant>1.28192e-08</forceConstant>
          <momentConstant>0.005964552</momentConstant>
          <direction>-1</direction>
        </rotor>
        <rotor>
          <jointName>drone3/m3_joint</jointName>
          <forceConstant>1.28192e-08</forceConstant>
          <momentConstant>0.005964552</momentConstant>
          <direction>1</direction>
        </rotor>
        <rotor>
          <jointName>drone3/m4_joint</jointName>
          <forceConstant>1.28192e-08</forceConstant>
          <momentConstant>0.005964552</momentConstant>
          <direction>-1</direction>
        </rotor>
      </rotorConfiguration>
    </plugin>
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
    </plugin>
    <plugin name="ignition::gazebo::systems::NavSat" filename="ignition-gazebo-navsat-system">
        <ros>
          <namespace>/drone3</namespace>
          <remapping>fix@/gps</remapping>
        </ros>
        <topic>gps</topic>
        <frame_name>drone3/gps_link</frame_name>
    </plugin>
    <plugin name="ignition::gazebo::systems::Imu" filename="libignition-gazebo-imu-system.so">
      <ros>
        <namespace>/drone3</namespace>
        <remapping>imu@/imu</remapping>
      </ros>
      <topic>imu</topic>
      <frame_name>drone3/imu_link</frame_name>
    </plugin>

  </model>
</sdf>


