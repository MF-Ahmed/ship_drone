<?xml version="1.0" encoding="utf-8"?>
<robot name="crazy2fly_base" xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- Include xacro files -->
  <xacro:include filename="$(find ls2n_drone_description)/models/crazy2fly_base/urdf/inertia.xacro" />
  <xacro:include filename="$(find ls2n_drone_description)/models/crazy2fly_base/urdf/c2f_materials.xacro" />
  <xacro:include filename="$(find ls2n_drone_description)/models/crazy2fly_base/urdf/c2f_frame.xacro" />
  <xacro:include filename="$(find ls2n_drone_description)/models/crazy2fly_base/urdf/c2f_motor.xacro" />
  <xacro:include filename="$(find ls2n_drone_description)/models/crazy2fly_base/urdf/c2f_propeller.xacro" />
  <xacro:include filename="$(find ls2n_drone_description)/models/crazy2fly_base/urdf/c2f_battery.xacro" />
  <xacro:include filename="$(find ls2n_drone_description)/models/crazy2fly_base/urdf/pixhawk5X.xacro" />
  <xacro:include filename="$(find ls2n_drone_description)/models/crazy2fly_base/urdf/rpi5.xacro" />

  <!-- Xacro properties -->
  <xacro:property name="frame_mass" value="0.5" />
  
  <xacro:property name="arm_length" value="0.17" />

  <xacro:property name="battery_mass" value="0.3" />
  <xacro:property name="battery_length" value="0.132" />
  <xacro:property name="battery_width" value="0.043" />
  <xacro:property name="battery_height" value="0.0273" />

  <xacro:property name="motor_length" value="0.03" />
  <xacro:property name="motor_radius" value="0.014" />
  <xacro:property name="motor_mass" value="0.05" />

  <xacro:property name="propeller_mass" value="0.01" />

  <!-- Base link -->
  <link name="base_link">
    <visual name='base_link_visual'>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <!-- Frame -->
  <xacro:c2f_frame mass="${frame_mass}">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:c2f_frame>

  <!-- Autopilot -->
  <xacro:pixhawk5X>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
  </xacro:pixhawk5X>

  <!-- RPi -->
  <xacro:rpi5>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
  </xacro:rpi5>

  <!-- Battery -->
  <xacro:c2f_battery length="${battery_length}" width="${battery_width}" height="${battery_height}" mass="${battery_mass}">
    <origin xyz="0 0 -0.014" rpy="0 0 0"/>
  </xacro:c2f_battery>

  <!-- Motors -->
  <xacro:c2f_motor name="motor1" radius="${motor_radius}" length="${motor_length}" mass="${motor_mass}">
    <origin xyz="${arm_length} 0 0.002" rpy="0 0 0" />
  </xacro:c2f_motor>

  <xacro:c2f_motor name="motor2" radius="${motor_radius}" length="${motor_length}" mass="${motor_mass}">
    <origin xyz="0.0 ${arm_length} 0.002" rpy="0 0 0" />
  </xacro:c2f_motor>

  <xacro:c2f_motor name="motor3" radius="${motor_radius}" length="${motor_length}" mass="${motor_mass}">
    <origin xyz="-${arm_length} 0.0 0.002" rpy="0 0 0" />
  </xacro:c2f_motor>

  <xacro:c2f_motor name="motor4" radius="${motor_radius}" length="${motor_length}" mass="${motor_mass}">
    <origin xyz="0.0 -${arm_length} 0.002" rpy="0 0 0" />
  </xacro:c2f_motor>

  <!-- Propellers -->
  <xacro:c2f_propeller name="propeller1" parent_name="motor1" dir="CCW" mass="${propeller_mass}">
    <origin xyz="0 0 ${motor_length+0.001}" rpy="0 0 0" />
  </xacro:c2f_propeller>

  <xacro:c2f_propeller name="propeller2" parent_name="motor2" dir="CW" mass="${propeller_mass}">
    <origin xyz="0 0 ${motor_length+0.001}" rpy="0 0 0" />
  </xacro:c2f_propeller>

  <xacro:c2f_propeller name="propeller3" parent_name="motor3" dir="CCW" mass="${propeller_mass}">
    <origin xyz="0 0 ${motor_length+0.001}" rpy="0 0 0" />
  </xacro:c2f_propeller>

  <xacro:c2f_propeller name="propeller4" parent_name="motor4" dir="CW" mass="${propeller_mass}">
    <origin xyz="0 0 ${motor_length+0.001}" rpy="0 0 0" />
  </xacro:c2f_propeller>

</robot>
