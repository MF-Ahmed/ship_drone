<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="c2f_propeller" params="name parent_name dir mass *origin">

    <xacro:if value="${dir == 'CW'}">
      <xacro:property name="mesh_file" value="propeller_8x4_CW.obj" />
      <xacro:property name="prop_color" value="red" />
    </xacro:if>
    <xacro:if value="${dir == 'CCW'}">
      <xacro:property name="mesh_file" value="propeller_8x4_CCW.obj" />
      <xacro:property name="prop_color" value="blue" />
    </xacro:if>

    <link name="${name}_link">
      <visual name="${name}_link_visual">
        <origin xyz="0 0 0" rpy="1.5708 0 0" />
        <geometry>
          <mesh filename="package://ls2n_drone_description/models/crazy2fly_base/meshes/${mesh_file}" scale="1.0 1.0 1.0"/>
        </geometry>
        <material name="${prop_color}" />
      </visual>

      <collision name="${name}_link_collision">
        <origin xyz="0 0 0" rpy="1.5708 0 0" />
        <geometry>
          <mesh filename="package://ls2n_drone_description/models/crazy2fly_base/meshes/${mesh_file}" scale="1.0 1.0 1.0"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="${mass}"/>
        <inertia ixx="1e-3" ixy="0.0" ixz="0.0" iyy="1e-3" iyz="0.0" izz="1e-3"/>
      </inertial>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="${parent_name}_link"/>
      <child link="${name}_link"/>
      <xacro:insert_block name="origin"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>
</robot>
